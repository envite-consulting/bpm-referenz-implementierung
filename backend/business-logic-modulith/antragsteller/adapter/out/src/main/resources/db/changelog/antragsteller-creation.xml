<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="001-create-antragsteller-table" author="developer">
        <comment>Erstelle Antragsteller Tabelle</comment>

        <createTable tableName="antragsteller">
            <column name="id" type="VARCHAR(36)">
                <constraints primaryKey="true" nullable="false" primaryKeyName="pk_antragsteller"/>
            </column>
            <column name="vorname" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="nachname" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="abteilung" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <rollback>
            <dropTable tableName="antragsteller"/>
        </rollback>
    </changeSet>

    <changeSet id="002-create-indexes" author="developer">
        <comment>Erstelle Indizes für bessere Query Performance</comment>

        <createIndex indexName="idx_antragsteller_id" tableName="antragsteller">
            <column name="id"/>
        </createIndex>

        <rollback>
            <dropIndex indexName="idx_antragsteller_id" tableName="antragsteller"/>
        </rollback>
    </changeSet>
</databaseChangeLog>
