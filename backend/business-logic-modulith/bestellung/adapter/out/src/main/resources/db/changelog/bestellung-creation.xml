<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="001-create-bestellung-table" author="developer">
        <comment>Erstelle Bestellung Tabelle</comment>

        <createTable tableName="bestellung">
            <column name="id" type="VARCHAR(36)">
                <constraints primaryKey="true" nullable="false" primaryKeyName="pk_bestellung"/>
            </column>
            <column name="fahrzeugreferenz" type="VARCHAR(36)">
                <constraints nullable="false"/>
            </column>
            <column name="antragstellerreferenz" type="VARCHAR(36)">
                <constraints nullable="false"/>
            </column>
            <column name="bestelldatum" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="status" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <rollback>
            <dropTable tableName="bestellung"/>
        </rollback>
    </changeSet>

    <changeSet id="002-add-data-constraints" author="developer">
        <comment>Füge zusätzliche Constraints für Datenintegrität hinzu</comment>

        <sql>
            ALTER TABLE bestellung
                ADD CONSTRAINT chk_bestellung_status
                    CHECK (status IN ('ANGELEGT',
                                      'GENEHMIGT',
                                      'BESTELLT',
                                      'AUSGELIEFERT',
                                      'STORNIERT'))
        </sql>

        <rollback>
            <sql>ALTER TABLE bestellung DROP CONSTRAINT chk_bestellung_status</sql>
        </rollback>
    </changeSet>
</databaseChangeLog>
