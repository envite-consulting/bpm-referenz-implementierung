<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="001-create-fahrzeug-table" author="developer">
        <comment>Erstelle Fahrzeug Tabelle</comment>

        <createTable tableName="fahrzeug">
            <column name="id" type="VARCHAR(36)">
                <constraints primaryKey="true" nullable="false" primaryKeyName="pk_fahrzeug"/>
            </column>
            <column name="hersteller" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="modell" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="jahr" type="INTEGER">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <rollback>
            <dropTable tableName="fahrzeug"/>
        </rollback>
    </changeSet>

    <changeSet id="002-create-bestellung-table" author="developer">
        <comment>Erstelle Bestellung Tabelle</comment>

        <createTable tableName="bestellung">
            <column name="id" type="VARCHAR(36)">
                <constraints primaryKey="true" nullable="false" primaryKeyName="pk_bestellung"/>
            </column>
            <column name="fahrzeug_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="antragsteller_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="bestelldatum" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="status" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <rollback>
            <dropTable tableName="bestellung"/>
        </rollback>
    </changeSet>

    <changeSet id="003-add-foreign-key-constraints" author="developer">
        <comment>Füge Foreign Key Constraint zwischen Bestellung und Fahrzeug hinzu</comment>

        <addForeignKeyConstraint
                baseTableName="bestellung"
                baseColumnNames="fahrzeug_id"
                constraintName="fk_bestellung_fahrzeug"
                referencedTableName="fahrzeug"
                referencedColumnNames="id"
                onDelete="CASCADE"
                onUpdate="CASCADE"/>

        <rollback>
            <dropForeignKeyConstraint baseTableName="bestellung" constraintName="fk_bestellung_fahrzeug"/>
        </rollback>
    </changeSet>

    <changeSet id="004-create-indexes" author="developer">
        <comment>Erstelle Indizes für bessere Query Performance</comment>

        <createIndex indexName="idx_bestellung_antragsteller" tableName="bestellung">
            <column name="antragsteller_id"/>
        </createIndex>

        <createIndex indexName="idx_bestellung_status" tableName="bestellung">
            <column name="status"/>
        </createIndex>

        <createIndex indexName="idx_bestellung_datum" tableName="bestellung">
            <column name="bestelldatum"/>
        </createIndex>

        <createIndex indexName="idx_bestellung_antragsteller_status" tableName="bestellung">
            <column name="antragsteller_id"/>
            <column name="status"/>
        </createIndex>

        <rollback>
            <dropIndex indexName="idx_bestellung_antragsteller" tableName="bestellung"/>
            <dropIndex indexName="idx_bestellung_status" tableName="bestellung"/>
            <dropIndex indexName="idx_bestellung_datum" tableName="bestellung"/>
            <dropIndex indexName="idx_bestellung_antragsteller_status" tableName="bestellung"/>
        </rollback>
    </changeSet>

    <changeSet id="006-add-data-constraints" author="developer">
        <comment>Füge zusätzliche Constraints für Datenintegrität hinzu</comment>

        <sql>
            ALTER TABLE bestellung
            ADD CONSTRAINT chk_bestellung_status
            CHECK (status IN ('ANGELEGT',
            'GENEHMIGT',
            'BESTELLT',
            'AUSGELIEFERT',
            'STORNIERT'))
        </sql>

        <rollback>
            <sql>ALTER TABLE bestellung DROP CONSTRAINT chk_bestellung_status</sql>
        </rollback>
    </changeSet>

    <changeSet id="007-add-audit-columns" author="developer">
        <comment>Füge Audit-Spalten für Nachverfolgung hinzu</comment>

        <addColumn tableName="fahrzeug">
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="created_by" type="VARCHAR(100)"/>
            <column name="updated_by" type="VARCHAR(100)"/>
        </addColumn>

        <addColumn tableName="bestellung">
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="created_by" type="VARCHAR(100)"/>
            <column name="updated_by" type="VARCHAR(100)"/>
        </addColumn>

        <rollback>
            <dropColumn tableName="fahrzeug" columnName="created_at"/>
            <dropColumn tableName="fahrzeug" columnName="updated_at"/>
            <dropColumn tableName="fahrzeug" columnName="created_by"/>
            <dropColumn tableName="fahrzeug" columnName="updated_by"/>
            <dropColumn tableName="bestellung" columnName="created_at"/>
            <dropColumn tableName="bestellung" columnName="updated_at"/>
            <dropColumn tableName="bestellung" columnName="created_by"/>
            <dropColumn tableName="bestellung" columnName="updated_by"/>
        </rollback>
    </changeSet>
</databaseChangeLog>
