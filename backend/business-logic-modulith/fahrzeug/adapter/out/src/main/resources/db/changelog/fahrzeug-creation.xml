<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="001-createfahrzeug-table" author="developer">
        <comment>Erstelle Fahrzeug Tabelle</comment>

        <createTable tableName="fahrzeug">
            <column name="id" type="VARCHAR(36)">
                <constraints primaryKey="true" nullable="false" primaryKeyName="pk_fahrzeug"/>
            </column>
            <column name="hersteller" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="modell" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="jahr" type="INT">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <rollback>
            <dropTable tableName="bestellung"/>
        </rollback>
    </changeSet>
</databaseChangeLog>
