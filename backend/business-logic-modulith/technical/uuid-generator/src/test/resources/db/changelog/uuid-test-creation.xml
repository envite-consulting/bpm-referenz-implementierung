<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="001-create-uuid-test" author="developer">
        <comment>Erstelle UUID Test Tabelle</comment>

        <createTable tableName="uuid_test">
            <column name="id" type="VARCHAR(36)">
                <constraints primaryKey="true" nullable="false" primaryKeyName="pk_bestellung"/>
            </column>
        </createTable>

        <rollback>
            <dropTable tableName="uuid_test"/>
        </rollback>
    </changeSet>
</databaseChangeLog>
